# ==============================================================================
# Brihanmumbai Police Tactical Intelligence Platform — Environment Template
# Copy this file to .env and adjust values for your deployment environment.
# ==============================================================================

# Server Network Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=production

# Security & Secret Key (IMPORTANT: Change to a strong random 32+ char secret in production)
SECRET_KEY=your-secret-key-here-min-32-chars

# CORS Origins (Comma-separated URLs permitted to access backend APIs)
CORS_ORIGINS=http://localhost:3000,https://your-frontend-deployment.vercel.app

# Audit Logging & Storage Database
AUDIT_DB_PATH=audit_log.db
DATABASE_URL=sqlite:///./audit_log.db
